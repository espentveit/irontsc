<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="IronTSC"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="IronTSC"
      UpgradeCode="7D5418E3-3CE8-44A6-945C-BBC8954CD468">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of IronTSC is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPHELPLINK" Value="https://github.com/espentveit/irontsc" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="IronTSC" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="IronTSC" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationExecutable" Guid="*" Win64="yes">
        <File Id="IronTscExe" Source="$(var.BinDir)\irontsc.exe" KeyPath="yes" />
      </Component>
      <Component Id="Documentation" Guid="*" Win64="yes">
        <File Id="Readme" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="UserPath" Guid="*" Win64="yes">
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\IronTSC" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuFolder" Guid="*" Win64="yes">
        <Shortcut
            Id="IronTscStartMenuShortcut"
            Name="IronTSC"
            Description="Remote Desktop client"
            Target="[INSTALLFOLDER]irontsc.exe"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\IronTSC" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="IronTSC" Level="1">
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="Documentation" />
      <ComponentRef Id="UserPath" />
      <ComponentRef Id="StartMenuFolder" />
    </Feature>
  </Product>
</Wix>
