# Environment variables (contains credentials)
.env

# Build artifacts
/target/

# IDE files
.vscode/
.idea/

# The test rig and everything it produces. Kept out of the repository because the captures
# are large and the keylogs and credentials in them are real; both stay on disk for testing.
/samples/
/test.sh

# Captures and keylogs anywhere else in the tree, for the same reason.
samples/*.pcap
samples/*.pcapng
samples/*.keys
samples/*.log
*.pcap
*.pcapng
*.keys

# Intermediate spec downloads and unpacked DOCX; regenerate with vendor/get-specs.sh.
/vendor/rdp-specs/
/vendor/rdp-specs-source/
